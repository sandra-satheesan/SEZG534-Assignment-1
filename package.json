{
  "name": "smart-todo-task-management-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:acceptance:us1": "npm test -- --runInBand --testMatch='**/acceptance/tasks.create-read.acceptance.test.js'",
    "test:acceptance": "node acceptance/run-acceptance.js",
    "lint": "eslint . --max-warnings=0",
    "security": "semgrep scan --config contracts/semgrep.yml --error --metrics=off --no-git-ignore src tests acceptance package.json"
  },
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "supertest": "7.3.1"
  },
  "overrides": {
    "deepmerge": "4.1.1",
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
